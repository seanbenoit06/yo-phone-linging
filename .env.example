# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# Never commit .env (it's in .gitignore).

# ElevenLabs dashboard → API Keys. Needs access to Agents / Conversational AI.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Open your agent in ElevenLabs; the Agent ID looks like agent_xxxxxxxx
ELEVENLABS_AGENT_ID=your_agent_id

# Optional: a separate agent per feature, so each feature has its own prompt and variables.
# Leave as-is to use ELEVENLABS_AGENT_ID for that feature.
ELEVENLABS_AGENT_ID_SCREEN=your_screen_agent_id
ELEVENLABS_AGENT_ID_CALENDAR=your_calendar_agent_id

# Run `python list_numbers.py` and copy the phone_number_id of your Photon number
ELEVENLABS_PHONE_NUMBER_ID=your_phone_number_id

# The phone Mom.exe should call, in E.164 format (+ country code, no spaces)
MY_PHONE_NUMBER=+12065551234

# Fills {{user_name}} in the agent prompt
USER_NAME=Jay

# Photon Beta dashboard (https://app.beta.photon.codes) → your project → Overview → "Project id"
PHOTON_PROJECT_ID=your_photon_project_id

# Photon Beta dashboard → API keys → New API key with project:read + project:write (starts with pho_sk_)
PHOTON_API_KEY=your_photon_api_key

# Perceptron platform (https://platform.perceptron.inc) → API keys. Used by webcam.py.
PERCEPTRON_API_KEY=your_perceptron_api_key

# Optional: camera webcam.py opens, by name. Empty = "MacBook Pro Camera".
# List names with: ffmpeg -f avfoundation -list_devices true -i ""
WEBCAM_NAME=

# Optional: opted-in friend Mom calls to snitch after an ignored call (E.164). Empty = never snitch.
FRIEND_PHONE_NUMBER=

# 1 = demo timings (text after 10s, call after 25s, callback after 45s). 0 = real timings.
DEMO_MODE=0

# 1 = main.py also asks webcam.py whether you're holding your phone.
USE_WEBCAM=0

# Google AI Studio (https://aistudio.google.com/apikey) → Create API key. Used by detector.py.
GEMINI_API_KEY=your_gemini_api_key

# Vercel dashboard → AI Gateway → API Keys. Only needed when DETECTOR_LLM=jev.
AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# Which LLM detector.py asks when its rules can't decide: gemini or jev
DETECTOR_LLM=gemini

# 1 = when detector.py can't tell from the title, it screenshots the front window and asks Gemini.
# Needs Screen Recording permission for your terminal. The screenshot is deleted right after.
DETECTOR_VISION=0

# lockin = real work that isn't your goal (another project, your job) counts as distracted.
# relaxed = Mom lets other real work slide.
DETECTOR_MODE=lockin

# UW Canvas. UW blocks personal access tokens, so tasks/canvas.py logs in with your browser cookie:
# Chrome → canvas.uw.edu (logged in) → Cmd+Option+I → Application → Cookies → https://canvas.uw.edu
# → canvas_session → copy its Value. It expires (and logging out kills it); copy it again when it does.
CANVAS_BASE_URL=https://canvas.uw.edu
CANVAS_SESSION_COOKIE=your_canvas_session_cookie
# Only if your school allows personal tokens (Account → Settings → + New Access Token). Wins over the cookie.
CANVAS_TOKEN=your_canvas_token

# Trello (read-only): see tasks/trello.py for how to get these
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
# The board Mom reads (short id from the board URL, e.g. trello.com/b/<id>/...)
TRELLO_BOARD_ID=your_board_id
# Optional: only read these lists (comma-separated IDs). Find them with: python -m tasks.trello --lists
TRELLO_LIST_IDS=

# Calendar: Google calendars to read, as comma-separated calendar IDs, or "all"
CALENDAR_IDS=primary
