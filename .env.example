# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# Never commit .env (it's in .gitignore).

# ElevenLabs dashboard → API Keys. Needs access to Agents / Conversational AI.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Open your agent in ElevenLabs; the Agent ID looks like agent_xxxxxxxx
ELEVENLABS_AGENT_ID=your_agent_id

# Run `python list_numbers.py` and copy the phone_number_id of your Photon number
ELEVENLABS_PHONE_NUMBER_ID=your_phone_number_id

# The phone Mom.exe should call, in E.164 format (+ country code, no spaces)
MY_PHONE_NUMBER=+12065551234

# Fills {{user_name}} in the agent prompt
USER_NAME=Jay
